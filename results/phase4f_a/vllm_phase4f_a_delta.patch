+    def _slackkv_guard_decision(
+        self, request: Request, required_blocks: int, free_blocks: int
+    ) -> tuple[str, dict[str, Any]]:
+        params = request.kv_transfer_params or {}
+        if params.get("progress_guard") is not True:
+            return ("REJECT" if free_blocks < required_blocks else "ADMIT"), {}
+        protected_key = params.get("protected_lease_key")
+        progress_blocks = params.get("protected_progress_blocks")
+        candidate_key = _slackkv_residency_lease_key(request)
+        if (
+            not isinstance(protected_key, str)
+            or not protected_key
+            or isinstance(progress_blocks, bool)
+            or not isinstance(progress_blocks, int)
+            or progress_blocks <= 0
+            or candidate_key is None
+        ):
+            raise ValueError("INVALID_PROGRESS_GUARD_REQUEST")
+        existing = len({
+            block.block_id
+            for block in self._slackkv_residency_leases.get(protected_key, [])
+            if not block.is_null
+        })
+        decision, hypothetical, reserve = _slackkv_psa_decision(
+            free_blocks, required_blocks, progress_blocks, existing,
+            candidate_key == protected_key,
+        )
+        return decision, {
+            "progress_guard": True,
+            "protected_lease_key": protected_key,
+            "protected_progress_blocks": progress_blocks,
+            "protected_existing_lease_blocks": existing,
+            "protected_hypothetical_lease_blocks": hypothetical,
+            "progress_reserve_blocks": reserve,
+            "candidate_required_blocks": required_blocks,
+            "free_blocks_after_candidate": free_blocks - required_blocks,
+        }
+
