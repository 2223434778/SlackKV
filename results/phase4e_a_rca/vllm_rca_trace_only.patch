+    def _slackkv_waiting_trace(
+        self,
+        request: Request,
+        event: str,
+        *,
+        free_blocks: int,
+        num_new_local_computed_tokens: int,
+        num_external_computed_tokens: int,
+        num_computed_tokens: int,
+        num_new_tokens: int,
+        blocked_count: int = 0,
+        will_break_waiting_loop: bool = False,
+    ) -> None:
