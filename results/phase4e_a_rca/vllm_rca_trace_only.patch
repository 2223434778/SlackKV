+            "SLACKKV_WAITING_TRACE %s",
+            json.dumps(
+                {
+                    "event": event,
+                    "timestamp_monotonic": time.monotonic(),
+                    "step_id": self._slackkv_scheduler_step_id,
+                    "request_id": request.request_id,
+                    "session": _slackkv_session(request),
+                    "free_blocks": free_blocks,
+                    "matching_lease": (
+                        _slackkv_session(request) in self._slackkv_residency_leases
+                    ),
+                    "active_lease_count": len(self._slackkv_residency_leases),
+                    "active_lease_unique_blocks": len(lease_blocks),
+                    "num_running": len(self.running),
+                    "num_waiting": len(self.waiting) + len(self.skipped_waiting),
+                    "num_new_local_computed_tokens": num_new_local_computed_tokens,
+                    "num_external_computed_tokens": num_external_computed_tokens,
+                    "num_computed_tokens": num_computed_tokens,
+                    "num_new_tokens": num_new_tokens,
+                    "blocked_count": blocked_count,
+                    "will_break_waiting_loop": will_break_waiting_loop,
+                },
+                separators=(",", ":"),
+            ),
+        )
+
     def _slackkv_trace(self, request: Request, event: str) -> None:
