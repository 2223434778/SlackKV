+def _slackkv_residency_lease_key(request: Request) -> str | None:
+    params = request.kv_transfer_params or {}
+    lease_key = params.get("slackkv_residency_lease_key")
+    if lease_key is None:
+        return None
+    if not isinstance(lease_key, str) or not lease_key:
+        raise AssertionError("invalid SlackKV residency lease key")
+    return lease_key
+
+
+def _slackkv_session(request: Request) -> str | None:
+    params = request.kv_transfer_params or {}
+    session = params.get("slackkv_session")
+    return session if isinstance(session, str) and session else None
+
+
+def _unique_slackkv_blocks(groups: tuple[list[Any], ...]) -> list[Any]:
+    blocks: dict[int, Any] = {}
+    for group in groups:
+        for block in group:
+            if not block.is_null:
+                blocks.setdefault(block.block_id, block)
+    return list(blocks.values())
+
