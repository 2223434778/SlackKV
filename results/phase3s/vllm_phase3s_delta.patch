+    def _slackkv_trace_residency_lease(
+        self,
+        event: str,
+        lease_key: str,
+        request_id: str,
+        blocks: list[Any],
+        *,
+        reason: str,
+        operation_cpu_us: float = 0.0,
+    ) -> None:
+        ref_cnts = [block.ref_cnt for block in blocks]
+        logger.info(
+            "SLACKKV_LEASE_TRACE %s",
+            json.dumps(
+                {
+                    "event": event,
+                    "lease_key": lease_key,
+                    "request_id": request_id,
+                    "timestamp_monotonic": time.monotonic(),
+                    "num_blocks": len(blocks),
+                    "min_ref_cnt": min(ref_cnts),
+                    "max_ref_cnt": max(ref_cnts),
+                    "reason": reason,
+                    "operation_cpu_us": operation_cpu_us,
+                    "active_lease_count": len(self._slackkv_residency_leases),
+                },
+                separators=(",", ":"),
+            ),
+        )
+
+    def _slackkv_acquire_residency_lease(
+        self, request: Request, lease_key: str
+    ) -> None:
+        if lease_key in self._slackkv_residency_leases:
+            raise AssertionError(f"duplicate SlackKV residency lease: {lease_key}")
+        blocks = _unique_slackkv_blocks(
+            self.kv_cache_manager.coordinator.get_blocks(request.request_id)
+        )
+        if not blocks:
+            raise AssertionError("cannot acquire an empty SlackKV residency lease")
+        started_ns = time.perf_counter_ns()
+        self.kv_cache_manager.block_pool.touch(blocks)
+        self._slackkv_residency_leases[lease_key] = blocks
+        operation_cpu_us = (time.perf_counter_ns() - started_ns) / 1000.0
+        self._slackkv_trace_residency_lease(
+            "LEASE_ACQUIRED",
+            lease_key,
+            request.request_id,
+            blocks,
+            reason="PREFETCH_LOAD_COMPLETE",
+            operation_cpu_us=operation_cpu_us,
+        )
+
+    def _slackkv_release_residency_lease(
+        self, request: Request, lease_key: str
+    ) -> None:
+        blocks = self._slackkv_residency_leases.get(lease_key)
+        if blocks is None:
+            raise AssertionError(f"release of unknown SlackKV residency lease: {lease_key}")
+        if not blocks:
+            raise AssertionError("cannot release an empty SlackKV residency lease")
+        if min(block.ref_cnt for block in blocks) < 2:
+            raise AssertionError("SlackKV lease release before real request ownership")
+        self._slackkv_trace_residency_lease(
+            "LEASE_RELEASE_READY",
+            lease_key,
+            request.request_id,
+            blocks,
+            reason="RESUME_ALLOCATED",
+        )
+        started_ns = time.perf_counter_ns()
+        self.kv_cache_manager.block_pool.free_blocks(blocks)
+        del self._slackkv_residency_leases[lease_key]
+        operation_cpu_us = (time.perf_counter_ns() - started_ns) / 1000.0
+        if min(block.ref_cnt for block in blocks) < 1:
+            raise AssertionError("SlackKV lease handoff lost real request ownership")
+        self._slackkv_trace_residency_lease(
+            "LEASE_RELEASED",
+            lease_key,
+            request.request_id,
+            blocks,
+            reason="RESUME_ALLOCATED",
+            operation_cpu_us=operation_cpu_us,
+        )
