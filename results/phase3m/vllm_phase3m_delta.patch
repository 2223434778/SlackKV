+def _is_slackkv_trace_resume(request: Request) -> bool:
+    params = request.kv_transfer_params
+    return bool(params and params.get("slackkv_trace_resume") is True)
+
+
+def _is_slackkv_first_token_gate(request: Request) -> bool:
+    params = request.kv_transfer_params
+    return bool(
+        params
+        and params.get("slackkv_trace_resume") is True
+        and params.get("slackkv_first_token_gate") is True
+    )
+
+
+def _slackkv_first_token_gate_limit(request: Request) -> int:
+    """Return the research gate capacity carried by a marked request."""
+    params = request.kv_transfer_params or {}
+    limit = params.get("slackkv_first_token_gate_limit", 1)
+    if isinstance(limit, bool) or not isinstance(limit, int) or limit < 1:
+        raise AssertionError("invalid SlackKV first-token gate limit")
+    return limit
+
+
+def _slackkv_first_token_gate_can_admit(
+    owners: set[str],
+    configured_limit: int | None,
+    request: Request,
+) -> tuple[bool, int]:
+    """Validate the run-wide limit and decide capacity using scheduler state."""
+    request_limit = _slackkv_first_token_gate_limit(request)
+    if configured_limit is not None and configured_limit != request_limit:
+        raise AssertionError("mixed SlackKV first-token gate limits")
+    return len(owners) < request_limit, request_limit
+
+
+def _slackkv_connector_first_request_ids(
+    *queues: RequestQueue,
+) -> list[str]:
+    """Return active research prefetch requests in scheduler order."""
+    return [
+        request.request_id
+        for queue in queues
+        for request in queue
+        if _is_slackkv_prefetch_only(request) and not request.is_finished()
+    ]
