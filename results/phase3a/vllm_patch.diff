+# SPDX-License-Identifier: Apache-2.0
+"""Focused tests for the research-only SlackKV native prefetch path."""
+
+from contextlib import contextmanager, nullcontext
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from vllm.distributed.kv_transfer.kv_connector.v1.offloading.common import (
+    OffloadingWorkerMetadata,
+    TransferJob,
+)
+from vllm.v1.core.sched.scheduler import _is_slackkv_prefetch_only
+from vllm.v1.outputs import KVConnectorOutput
+from vllm.v1.worker.kv_connector_model_runner_mixin import (
+    KVConnectorModelRunnerMixin,
+)
+
+pytestmark = pytest.mark.cpu_test
+
+
+def test_prefetch_only_flag_is_isolated_from_normal_requests():
+    special = SimpleNamespace(
+        kv_transfer_params={"slackkv_prefetch_only": True}
+    )
+    normal = SimpleNamespace(kv_transfer_params={"max_offload_tokens": 0})
+    assert _is_slackkv_prefetch_only(special)
+    assert not _is_slackkv_prefetch_only(normal)
+
+
+def test_prefetch_load_metadata_keeps_research_flag():
+    job = TransferJob(
+        req_id="prefetch-1",
+        transfer_spec=(SimpleNamespace(), SimpleNamespace()),
+        slackkv_prefetch_only=True,
+    )
+    assert job.slackkv_prefetch_only is True
+
+
+def test_transfer_observation_aggregates_without_changing_completion_counts():
+    first = OffloadingWorkerMetadata()
+    second = OffloadingWorkerMetadata()
+    first.mark_completed(4, 0.005, 100)
+    second.mark_completed(4, 0.007, 120)
+    merged = first.aggregate(second)
+    assert merged.completed_jobs == {4: 2}
+    assert merged.slackkv_completed_job_stats == {4: (0.007, 220)}
+
+
+def test_no_forward_branch_returns_connector_only_output():
+    @contextmanager
+    def connector_output(*args, **kwargs):
+        yield KVConnectorOutput()
+
+    scheduler_output = SimpleNamespace(
+        kv_connector_metadata=SimpleNamespace(load_jobs={})
+    )
+    with (
+        patch.object(
+            KVConnectorModelRunnerMixin,
+            "_get_kv_connector_output",
+            side_effect=connector_output,
+        ) as mocked,
+        patch(
+            "vllm.v1.worker.kv_connector_model_runner_mixin.set_forward_context",
+            return_value=nullcontext(),
+        ),
+    ):
+        result = KVConnectorModelRunnerMixin.kv_connector_no_forward(
+            scheduler_output, SimpleNamespace()
+        )
+    mocked.assert_called_once()
+    assert result.sampled_token_ids == []
