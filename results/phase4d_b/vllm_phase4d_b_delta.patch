+    def _slackkv_capacity_required_blocks(self, request: Request) -> int:
+        params = request.kv_transfer_params or {}
+        required = params.get("required_blocks")
+        prompt_ids = request.prompt_token_ids
+        if (
+            not _is_slackkv_prefetch_only(request)
+            or isinstance(required, bool)
+            or not isinstance(required, int)
+            or required <= 0
+            or prompt_ids is None
+            or len(prompt_ids) % self.block_size != 0
+            or required != len(prompt_ids) // self.block_size
+        ):
+            raise ValueError("INVALID_CAPACITY_GUARD_REQUEST")
+        return required
+
+    def _slackkv_capacity_owned_block_ids(self, requests: Iterable[Request]) -> set[int]:
+        block_ids: set[int] = set()
+        for request in requests:
+            try:
+                groups = self.kv_cache_manager.get_blocks(request.request_id).blocks
+            except (KeyError, ValueError):
+                continue
+            block_ids.update(
+                block.block_id
+                for group in groups
+                for block in group
+                if not block.is_null
+            )
+        return block_ids
+
