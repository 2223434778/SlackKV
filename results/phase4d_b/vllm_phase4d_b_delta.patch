+    def _slackkv_preflight_capacity_guards(self) -> None:
+        """Reject impossible guarded loads before connector-first work starts."""
+        seen: set[str] = set()
+        for request_queue in (self.waiting, self.skipped_waiting):
+            for request in list(request_queue):
+                if request.request_id in seen or not _is_slackkv_capacity_guarded(
