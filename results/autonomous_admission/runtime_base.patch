+    def _slackkv_trace_source_readiness(self, req_status: RequestOffloadState) -> None:
+        """Observe a traced next-turn prefix without changing offload policy."""
+        params = req_status.req.kv_transfer_params or {}
+        boundary_id = params.get("slackkv_trace_next_boundary")
+        required = params.get("slackkv_trace_source_required_tokens")
+        if not isinstance(boundary_id, str) or type(required) is not int:
+            return
+        if boundary_id in self._slackkv_source_ready_emitted:
+            return
+        if required <= 0 or required % 16 or len(req_status.group_states) != 1:
+            return
+        group = req_status.group_states[0]
+        block_size = self.config.kv_group_configs[0].offloaded_block_size
+        if block_size != 16:
+            return
+        required_blocks = required // block_size
+        available_keys = group.offload_keys[:required_blocks]
+        if (
+            type(params.get("slackkv_trace_next_isl")) is int
+            and type(params.get("slackkv_trace_next_pause_ms")) in (int, float)
+        ):
