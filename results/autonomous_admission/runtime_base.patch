+    local_ready: Sequence[bool], external_ready: Sequence[bool]
+) -> tuple[int, int]:
+    """Return contiguous ready blocks and external-only blocks in that prefix."""
+    if len(local_ready) != len(external_ready):
+        raise ValueError("local and external readiness vectors must have equal length")
+    covered = 0
+    external_needed = 0
