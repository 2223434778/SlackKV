+    protected_progress_blocks: int,
+    existing_protected_lease_blocks: int,
+    candidate_has_matching_lease: bool,
+) -> tuple[str, int, int]:
+    hypothetical = max(
+        existing_protected_lease_blocks,
+        required_blocks if candidate_has_matching_lease else 0,
+    )
+    reserve = max(0, protected_progress_blocks - hypothetical)
+    if free_blocks < required_blocks:
+        return "CAPACITY_REJECT", hypothetical, reserve
